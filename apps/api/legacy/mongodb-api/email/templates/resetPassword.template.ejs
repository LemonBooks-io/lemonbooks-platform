<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password - LemonBooks</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        line-height: 1.6;
        color: #1f2937;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
        min-height: 100vh;
      }

      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
      }

      .header {
        background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
        color: white;
        padding: 40px 30px;
        text-align: center;
        position: relative;
      }

      .header::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
        opacity: 0.3;
      }

      .header-content {
        position: relative;
        z-index: 1;
      }

      .logo {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 8px;
        letter-spacing: -0.02em;
      }

      .header-subtitle {
        font-size: 18px;
        opacity: 0.9;
        font-weight: 500;
      }

      .security-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.15);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 14px;
        margin-top: 20px;
        backdrop-filter: blur(10px);
      }

      .content {
        padding: 40px 30px;
      }

      .greeting {
        font-size: 20px;
        font-weight: 600;
        color: #111827;
        margin-bottom: 16px;
      }

      .intro-text {
        font-size: 16px;
        color: #6b7280;
        margin-bottom: 24px;
        line-height: 1.7;
      }

      .info-card {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border: 2px solid #fecaca;
        border-radius: 12px;
        padding: 24px;
        margin: 24px 0;
        position: relative;
        overflow: hidden;
      }

      .info-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #ef4444, #dc2626, #b91c1c);
      }

      .info-text {
        font-size: 15px;
        color: #991b1b;
        line-height: 1.6;
        margin-bottom: 12px;
      }

      .info-text strong {
        color: #7f1d1d;
        font-weight: 600;
      }

      .cta-section {
        text-align: center;
        margin: 32px 0;
      }

      .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        color: white;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 14px rgba(220, 38, 38, 0.4);
      }

      .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(220, 38, 38, 0.5);
      }

      .help-section {
        background: #f9fafb;
        border-radius: 8px;
        padding: 20px;
        margin: 24px 0;
        text-align: center;
      }

      .help-text {
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 8px;
      }

      .contact-link {
        color: #3b82f6;
        text-decoration: none;
        font-weight: 500;
      }

      .contact-link:hover {
        text-decoration: underline;
      }

      .footer {
        background: #111827;
        color: white;
        padding: 30px;
        text-align: center;
      }

      .footer-brand {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #ffffff;
      }

      .footer-text {
        color: #9ca3af;
        font-size: 14px;
        margin-bottom: 4px;
      }

      .divider {
        height: 2px;
        background: linear-gradient(90deg, transparent, #e5e7eb, transparent);
        margin: 24px 0;
      }

      /* Responsive */
      @media (max-width: 600px) {
        body {
          padding: 10px;
        }

        .email-container {
          border-radius: 12px;
        }

        .header,
        .content,
        .footer {
          padding: 24px 20px;
        }

        .cta-button {
          padding: 12px 24px;
          font-size: 15px;
        }
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <!-- Header -->
      <div class="header">
        <div class="header-content">
          <div class="logo">LemonBooks</div>
          <div class="header-subtitle">Password Reset Request</div>
          <div class="security-badge">🔒 Secure Password Reset</div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="content">
        <div class="greeting">Hi <%= body.name %>,</div>

        <div class="intro-text">
          We received a request to reset your password. Don't worry, we're here
          to help you regain access to your account!
        </div>

        <div class="info-card">
          <div class="info-text">
            Click the button below to reset your password. This link is valid
            for <strong>15 minutes</strong> for security reasons.
          </div>
          <div class="info-text">
            If you didn't request a password reset, you can safely ignore this
            email. Your password will remain unchanged.
          </div>
        </div>

        <!-- CTA Button -->
        <div class="cta-section">
          <a href="<%= body.resetPasswordUrl %>" class="cta-button">
            🔑 Reset My Password
          </a>
        </div>

        <div class="divider"></div>

        <!-- Help Section -->
        <div class="help-section">
          <div class="help-text">
            Having trouble? Contact our support team at
          </div>
          <a href="mailto:support@lemonbooks.app" class="contact-link"
            >support@lemonbooks.app</a
          >
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <div class="footer-brand">LemonBooks</div>
        <div class="footer-text">Simplifying business management</div>
        <div class="footer-text">
          © <%= new Date().getFullYear() %> LemonBooks. All rights reserved.
        </div>
      </div>
    </div>
  </body>
</html>
